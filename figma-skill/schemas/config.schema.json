{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude.ai/skills/figma-skill/schemas/config.schema.json",
  "title": "Figma task-state project config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultBranch",
    "taskIdFormat",
    "leaseMinutes",
    "evidencePolicy",
    "redactionPolicy"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "defaultBranch": { "type": "string", "minLength": 1 },
    "taskIdFormat": { "type": "string", "const": "YYYYMMDD-slug" },
    "leaseMinutes": { "type": "integer", "minimum": 1 },
    "evidencePolicy": { "type": "string", "enum": ["tracked"] },
    "redactionPolicy": { "type": "string", "enum": ["strict"] }
  }
}
