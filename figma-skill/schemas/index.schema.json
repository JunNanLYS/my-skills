{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude.ai/skills/figma-skill/schemas/index.schema.json",
  "title": "Figma task-state index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "tasks"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/$defs/taskSummary" }
    }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*(?:-[0-9]{2})?$"
    },
    "taskSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "title",
        "status",
        "archiveStatus",
        "updatedAt"
      ],
      "properties": {
        "taskId": { "$ref": "#/$defs/taskId" },
        "title": { "type": "string", "minLength": 1 },
        "taskType": { "type": "string", "enum": ["Create", "Modify", "Audit", "Migrate", "Export"] },
        "writeRequired": { "type": "boolean" },
        "status": {
          "type": "string",
          "enum": [
            "DRAFT",
            "WAITING_DESIGN_APPROVAL",
            "WAITING_WRITE_APPROVAL",
            "READY",
            "ACTIVE",
            "BLOCKED",
            "STALE",
            "NEEDS_REPLAN",
            "FAILED",
            "CANCELLED",
            "COMPLETED",
            "SUPERSEDED"
          ]
        },
        "archiveStatus": {
          "type": "string",
          "enum": ["NOT_ARCHIVED", "ARCHIVING", "ARCHIVED", "ARCHIVE_FAILED"]
        },
        "currentWorkflow": { "type": "string", "minLength": 1 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
