{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude.ai/skills/figma-skill/schemas/task-state.schema.json",
  "title": "Figma persisted task state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "taskId",
    "title",
    "taskType",
    "writeRequired",
    "status",
    "archiveStatus",
    "currentWorkflow",
    "gate",
    "gateStatus",
    "approval",
    "batch",
    "correctionRounds",
    "resume",
    "observedContext",
    "validation",
    "evidenceRefs",
    "relatedTasks",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "revision": { "type": "integer", "minimum": 0 },
    "taskId": { "$ref": "#/$defs/taskId" },
    "title": { "type": "string", "minLength": 1 },
    "taskType": { "type": "string", "enum": ["Create", "Modify", "Audit", "Migrate", "Export"] },
    "writeRequired": { "type": "boolean" },
    "status": { "$ref": "#/$defs/status" },
    "archiveStatus": { "$ref": "#/$defs/archiveStatus" },
    "currentWorkflow": { "type": "string", "minLength": 1 },
    "gate": { "type": "string", "minLength": 1 },
    "gateStatus": { "type": "string", "enum": ["PENDING", "PASS", "FAIL", "BLOCKED", "NOT_REQUIRED"] },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["designSystem", "figmaWrite"],
      "properties": {
        "designSystem": { "$ref": "#/$defs/approvalStatus" },
        "figmaWrite": { "$ref": "#/$defs/approvalStatus" }
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "lastCompleted"],
      "properties": {
        "current": { "type": "integer", "minimum": 0 },
        "lastCompleted": { "type": "integer", "minimum": 0 }
      }
    },
    "correctionRounds": { "type": "integer", "minimum": 0 },
    "resume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "lastCheckpoint", "liveRevalidation"],
      "properties": {
        "required": { "type": "boolean" },
        "lastCheckpoint": { "type": "string", "minLength": 1 },
        "liveRevalidation": { "type": "string", "enum": ["REQUIRED", "PASS", "NOT_REQUIRED"] }
      }
    },
    "observedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figmaFile", "page", "nodeIds"],
      "properties": {
        "figmaFile": { "type": ["string", "null"] },
        "page": { "type": ["string", "null"] },
        "nodeIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual"],
      "properties": {
        "visual": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "reviewed", "summary"],
          "properties": {
            "required": { "type": "boolean" },
            "reviewed": { "type": "boolean" },
            "summary": { "type": ["string", "null"] }
          }
        }
      }
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "relatedTasks": { "type": "array", "items": { "$ref": "#/$defs/taskId" } },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "taskId": {
      "type": "string",
      "pattern": "^[0-9]{8}-[a-z0-9]+(?:-[a-z0-9]+)*(?:-[0-9]{2})?$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "WAITING_DESIGN_APPROVAL",
        "WAITING_WRITE_APPROVAL",
        "READY",
        "ACTIVE",
        "BLOCKED",
        "STALE",
        "NEEDS_REPLAN",
        "FAILED",
        "CANCELLED",
        "COMPLETED",
        "SUPERSEDED"
      ]
    },
    "archiveStatus": {
      "type": "string",
      "enum": ["NOT_ARCHIVED", "ARCHIVING", "ARCHIVED", "ARCHIVE_FAILED"]
    },
    "approvalStatus": {
      "type": "string",
      "enum": ["PENDING", "APPROVED", "REJECTED", "NOT_REQUIRED"]
    }
  }
}
